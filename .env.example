# Plantilla de variables de entorno — VentoleraApp
#
# Copiar a `.env.local` y completar con los valores reales. Este archivo versiona
# solo los NOMBRES de las variables: nunca incluir valores ni claves.
# `.env.local` no se versiona (ver `.gitignore`).

# Google Drive / OAuth — API routes de Drive y scripts
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=

# Token de la cuenta que da acceso a las carpetas de Drive.
# Se obtiene con el flujo OAuth: `node scripts/generateAuthUrl.js` y el callback
# de `/api/oauth2callback`.
GOOGLE_REFRESH_TOKEN=

# Firebase Admin SDK — API routes y scripts que escriben en Firestore/Storage
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=

# Clave privada de la service account con los saltos de línea escapados:
# `\n` literales en una sola línea. No pegar el PEM con saltos reales.
FIREBASE_PRIVATE_KEY=
