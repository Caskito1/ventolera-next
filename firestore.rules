rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Colección de usuarios
    match /usuarios/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;

      // Subcolección de favoritos
      match /favoritos/{favId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }

    // Colección de partituras
    // Escritura solo por el Admin SDK (rutas autenticadas); el SDK web no escribe.
    match /partituras/{partituraId} {
      allow write: if false;
      allow read: if request.auth != null;
    }

    // Colección de temas (canción + metadatos de audio).
    // La escribe solo el Admin SDK (alta de partituras, alta de audio, seed).
    match /temas/{slug} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    // Colección de recibos de sueldo.
    // Todo acceso va por el Admin SDK (rutas autenticadas); el cliente no accede.
    match /recibos_de_sueldo/{reciboId} {
      allow read, write: if false;
    }
  }
}
