rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /{allPaths=**} {
      // Deny total: ningún acceso directo al bucket.
      // El audio se sube y se reproduce solo por URLs firmadas de corta duración,
      // emitidas por endpoints autenticados (/api/audio/*). Cierra DT-07.
      allow read, write: if false;
    }
  }
}
